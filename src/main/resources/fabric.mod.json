{
	"schemaVersion": 1,
	"id": "survivalcreativitymod",
	"version": "${version}",
	"name": "SurvivalCreativityMod",
	"description": "Plan builds in creative-like imagination mode, then bring them into survival with ghost overlays.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/survivalcreativitymod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ortero.survivalcreativity.com.SurvivalCreativityMod"
		],
		"client": [
			"ortero.survivalcreativity.com.client.SurvivalCreativityModClient"
		]
	},
	"mixins": [
		"survivalcreativitymod.mixins.json",
		{
			"config": "survivalcreativitymod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}